#!/usr/bin/env bash
set -uo pipefail  # NO -e!!!

ts() { printf '%(%Y%m%d_%H%M%S)T' -1; }  # bash builtin timestamp
log() {
  local level="$1"; shift
  printf '%s [%s] %s\n' "$(ts)" "$level" "$*" >&2
}
info()  { log INFO  "$*"; }
warn()  { log WARN  "$*"; }
error() { log ERROR "$*"; }
die()   { error "$*"; exit 1; }

see() ( { set -x; } 2>/dev/null ; "$@" )

inpath_or_die() { command -v "$1" >/dev/null 2>&1 || die "$1 not in PATH"; }

ensure_x_env() {
  local ix dpy_num sock auth xcmd

  # If DISPLAY is unset, prefer :0 once its socket appears (same intent as today).
  if [[ -z "${DISPLAY-}" ]]; then
    export DISPLAY=":0"
    info "DISPLAY was unset; defaulting to DISPLAY=:0"
  fi

  # Compute socket for DISPLAY (handles :0, :1, :0.0, etc.)
  dpy_num="${DISPLAY#:}"
  dpy_num="${dpy_num%%.*}"
  sock="/tmp/.X11-unix/X${dpy_num}"

  # Wait for X to be usable: socket exists + xauth (if needed) + xrandr responds.
  # 60s at 0.5s intervals (adjust if you want)
  for ix in {1..120}; do
    : "$ix"

    # 1) Wait for the display socket
    if [[ ! -S "$sock" ]]; then
      sleep 0.5
      continue
    fi

    # 2) If XAUTHORITY is unset, keep trying to discover it
    if [[ -z "${XAUTHORITY-}" ]]; then
      # Match likely Xorg command line (Xorg, Xorg.bin, sometimes X)
      # Prefer a line that references the display number.
      xcmd="$(pgrep -a -f '(^|/)(Xorg|Xorg\.bin|X)\b' 2>/dev/null | grep -E "(:${dpy_num}\b| :${dpy_num}\b)" | head -n 1 || true)"
      [[ -n "$xcmd" ]] || xcmd="$(pgrep -a -f '(^|/)(Xorg|Xorg\.bin|X)\b' 2>/dev/null | head -n 1 || true)"

      auth="$(sed -n 's/.* -auth \([^ ]*\).*/\1/p' <<<"$xcmd" | head -n 1 || true)"
      if [[ -n "$auth" && -r "$auth" ]]; then
        export XAUTHORITY="$auth"
        info "XAUTHORITY was unset; discovered XAUTHORITY=$XAUTHORITY"
      fi
    fi

    # 3) If xrandr works, we are done.
    if xrandr --query >/dev/null 2>&1; then
      return 0
    fi

    sleep 0.5
  done

  die "Cannot query X via xrandr after waiting (DISPLAY=$DISPLAY, sock=$sock, XAUTHORITY=${XAUTHORITY-<unset>})"
}

dump_xrandr_connectors() {
  info "xrandr connectors snapshot (DISPLAY=$DISPLAY XAUTHORITY=${XAUTHORITY-<unset>}):"
  xrandr --query 2>&1 | awk '/ connected| disconnected/{print "  " $0}' >&2
  info "DISP_primary=$(printf %q "$DISP_primary") DISP_4k=$(printf %q "$DISP_4k")"
}

inpath_or_die xrandr
inpath_or_die pgrep
inpath_or_die grep
inpath_or_die sed
inpath_or_die awk

ensure_x_env

# Adjust these to match `xrandr --query` output names on your system
DISP_primary="eDP"        RES_DISP_primary="1920x1080"
DISP_4k="HDMI-A-0"        RES_DISP_4k="3840x2160"

log_hdmi_props() {
  info "HDMI properties on $DISP_4k:"
  xrandr --verbose | awk '
    $1=="'"$DISP_4k"'" && ($2=="connected" || $2=="disconnected") {p=1}
    p && /^[A-Za-z].*(connected|disconnected)/ && $1!="'"$DISP_4k"'" {exit}
    p && /(Colorspace|content type|max bpc)/ {print "  " $0}
  ' >&2
}

xrandr_supports_prop_value() {
  # usage: xrandr_supports_prop_value HDMI-A-0 "content type" "Graphics"
  local out="$1" prop="$2" val="$3"
  xrandr --verbose | awk -v out="$out" -v prop="$prop" -v val="$val" '
    $1==out && ($2=="connected" || $2=="disconnected") {p=1}
    p && /^[A-Za-z].*(connected|disconnected)/ && $1!=out {exit}
    p && $1==prop":" { # property line
      # consume rest of line; supported values appear on subsequent indented line(s) in your output
      got=1
    }
    p && got && $1=="supported:" {
      # check if val is one of the supported comma-separated tokens
      line=$0
      sub(/^.*supported:[[:space:]]*/, "", line)
      gsub(/,/, "", line)
      n=split(line, a, /[[:space:]]+/)
      for (i=1; i<=n; i++) if (a[i]==val) {exit 0}
      exit 1
    }
  ' >/dev/null 2>&1
}

apply_hdmi_pc_tweaks() {
  local changed=0

  if xrandr_supports_prop_value "$DISP_4k" "Colorspace" "Default"; then
    local cur
    cur="$(xrandr --verbose | awk '
      $1=="'"$DISP_4k"'" && ($2=="connected" || $2=="disconnected") {p=1}
      p && /^[A-Za-z].*(connected|disconnected)/ && $1!="'"$DISP_4k"'" {exit}
      p && $1=="Colorspace:" {print $2; exit}
    ')"
    if [[ "$cur" != "Default" ]]; then
      xrandr --output "$DISP_4k" --set "Colorspace" "Default" || true
      changed=1
    fi
  else
    warn "Skipping Colorspace=Default (not supported on $DISP_4k)"
  fi

  if xrandr_supports_prop_value "$DISP_4k" "content type" "Graphics"; then
    local cur
    cur="$(xrandr --verbose | awk '
      $1=="'"$DISP_4k"'" && ($2=="connected" || $2=="disconnected") {p=1}
      p && /^[A-Za-z].*(connected|disconnected)/ && $1!="'"$DISP_4k"'" {exit}
      p && $1=="content" && $2=="type:" {print $3; exit}
    ')"
    if [[ "$cur" != "Graphics" ]]; then
      xrandr --output "$DISP_4k" --set "content type" "Graphics" || true
      changed=1
    fi
  else
    warn "Skipping content type=Graphics (not supported on $DISP_4k)"
  fi

  # max bpc: range property; read current and only set if needed
  local cur_bpc
  cur_bpc="$(xrandr --verbose | awk '
    $1=="'"$DISP_4k"'" && ($2=="connected" || $2=="disconnected") {p=1}
    p && /^[A-Za-z].*(connected|disconnected)/ && $1!="'"$DISP_4k"'" {exit}
    p && $1=="max" && $2=="bpc:" {print $3; exit}
  ')"
  if [[ -n "$cur_bpc" && "$cur_bpc" != "8" ]]; then
    if xrandr --output "$DISP_4k" --set "max bpc" 8 >/dev/null 2>&1; then
      changed=1
    else
      warn "Skipping max bpc=8 (not supported or rejected on $DISP_4k)"
    fi
  fi

  if [[ "$changed" -eq 1 ]]; then
    info "Applied HDMI PC tweaks on $DISP_4k (Colorspace=Default, content=Graphics, max_bpc=8)"
  fi
}

# Wait up to ~120 seconds for HDMI to appear connected
for _ in {1..60}; do
  if xrandr --query | grep -q "^${DISP_4k}[[:space:]]connected"; then
    apply_hdmi_pc_tweaks
    if see xrandr --fb "$RES_DISP_4k" \
         --output "$DISP_4k" --mode "$RES_DISP_4k" --primary \
         --output "$DISP_primary" --mode "$RES_DISP_primary" --scale-from "$RES_DISP_4k" --same-as "$DISP_4k"
    then
      apply_hdmi_pc_tweaks
      log_hdmi_props
      info "mirror-setup successful!"
      exit 0
    fi
    warn "FAILED to mirror $DISP_primary ($RES_DISP_primary) to $DISP_4k ($RES_DISP_4k)"
  fi
  sleep 2
done

dump_xrandr_connectors
warn "FAILED: '$DISP_4k connected' never found"
exit 0
