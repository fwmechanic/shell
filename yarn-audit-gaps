#!/usr/bin/env bash
set -euo pipefail

# Extract advisories from yarn audit NDJSON
advisories=$(yarn audit --json 2>/dev/null || true)

# Parse advisories into a deduplicated list (highest severity wins)
parsed=$(echo "$advisories" | jq -s '
  [.[] | select(.type == "auditAdvisory") | .data.advisory]
  | group_by(.module_name)
  | map(
      sort_by(
        (.severity | {critical:4,high:3,moderate:2,low:1,info:0}[.] // -1)
      ) | last
    )
  | map({
      module: .module_name,
      patched: .patched_versions,
      severity: .severity,
      title: .title
    })
')

# Function to look up version from yarn.lock
get_version() {
  local pkg="$1"
  # Match "pkg@version": or pkg@version: then grab the version line
  awk -v pkg="$pkg" '
    BEGIN { found = 0 }
    /^[^ ]/ {
      # Check if this line contains our package name
      if (match($0, "\"?" pkg "@[^:]+\":?") || match($0, "^" pkg "@[^:]+:")) {
        found = 1
        next
      }
      found = 0
    }
    found && /^  version / {
      gsub(/^  version "?|"$/, "")
      print
      exit
    }
  ' yarn.lock
}

# Add current versions from yarn.lock
echo "$parsed" | jq -c '.[]' | while read -r item; do
  module=$(echo "$item" | jq -r '.module')
  current=$(get_version "$module")
  echo "$item" | jq --arg current "${current:-unknown}" '. + {current: $current}'
done | jq -s '
  sort_by((.severity | {critical:0,high:1,moderate:2,low:3,info:4}[.] // 5))
'
