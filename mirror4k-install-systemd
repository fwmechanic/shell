#!/usr/bin/env bash

set -uo pipefail  # NO -e

usage() {
  cat >&2 <<EOF
Installs/updates mirror4k as a single systemd oneshot service (no .path unit).
Examples:
  sudo ./mirror4k-install-systemd ./mirror4k
Usage:
  sudo $0 [SOURCE_SCRIPT]
  sudo $0 --remove

Env overrides:
  SERVICE_NAME=mirror4k
  INSTALLER_LOG_FILE=/var/log/mirror4k-setup.log
EOF
  exit 2
}

ts() { printf '%(%Y%m%d_%H%M%S)T' -1; }

init_logging() {
  local uid
  uid="$(id -u 2>/dev/null || echo 99999)"

  if [[ -n "${INSTALLER_LOG_FILE-}" ]]; then
    :
  elif [[ "$uid" -eq 0 ]]; then
    INSTALLER_LOG_FILE="/var/log/mirror4k-setup.log"
  else
    local state_dir="${XDG_STATE_HOME:-$HOME/.local/state}"
    INSTALLER_LOG_FILE="$state_dir/mirror4k-setup.log"
  fi

  mkdir -p "$(dirname "$INSTALLER_LOG_FILE")" 2>/dev/null || true
}

log() {
  local level="$1"; shift
  printf '%s [%s] %s\n' "$(ts)" "$level" "$*" | tee -a "$INSTALLER_LOG_FILE" >&2
}
info()  { log INFO  "$*"; }
warn()  { log WARN  "$*"; }
error() { log ERROR "$*"; }
die()   { error "$*"; exit 1; }

see() ( { set -x; } 2>/dev/null ; "$@" )

inpath_or_die() { command -v "$1" >/dev/null 2>&1 || die "$1 not in PATH"; }

# -------------------------- config --------------------------

SERVICE_NAME="${SERVICE_NAME:-mirror4k}"

SRC_SCRIPT="${1:-./mirror4k}"
INSTALL_PATH="/usr/local/bin/$SERVICE_NAME"

# -------------------------- helpers --------------------------

require_root() {
  [[ "$(id -u)" -eq 0 ]] || die "Run as root (use sudo)."
}

require_readable_file() {
  local f="$1"
  [[ -f "$f" ]] || die "Source script not found: $f"
  [[ -r "$f" ]] || die "Source script not readable: $f"
}

ensure_parent_dir() {
  local p="$1"
  local d
  d="$(dirname "$p")"
  [[ -d "$d" ]] || see mkdir -p "$d" || die "Failed to create directory: $d"
}

ensure_mode() {
  local path="$1"
  local want="$2"
  local have=""

  have="$(stat -c '%a' "$path" 2>/dev/null || true)"

  # Normalize leading zeros so 0644 and 644 compare equal
  want="${want#0}"
  have="${have#0}"

  if [[ -n "$have" && "$have" == "$want" ]]; then
    return 0
  fi

  see chmod "$2" "$path" || die "Failed to chmod $2: $path"
}

install_or_fixup_script() {
  local src="$1"
  local dst="$2"

  if [[ "$src" == "$dst" ]]; then
    info "Source already at install path; ensuring mode/owner: $dst"
    [[ -x "$dst" ]] || see chmod 0755 "$dst" || die "Failed to chmod +x: $dst"
    ensure_mode "$dst" 0755
    see chown root:root "$dst" 2>/dev/null || warn "chown root:root failed (continuing)"
    return 0
  fi

  ensure_parent_dir "$dst"

  # Idempotent: only install if content differs (or missing)
  if [[ -f "$dst" ]] && cmp -s "$src" "$dst"; then
    info "Script unchanged: $dst"
    ensure_mode "$dst" 0755
    return 0
  fi

  if command -v install >/dev/null 2>&1; then
    see install -o root -g root -m 0755 "$src" "$dst" || die "Failed to install $src to $dst"
  else
    warn "install(1) not found; falling back to cp/chmod"
    see cp -f "$src" "$dst" || die "Failed to copy $src to $dst"
    ensure_mode "$dst" 0755
    see chown root:root "$dst" 2>/dev/null || warn "chown root:root failed (continuing)"
  fi

  SCRIPT_CHANGED=1
  info "Installed/updated script to: $dst"
}

write_if_changed() {
  # Writes stdin to target path only if it differs.
  # Sets UNIT_CHANGED=1 if any change occurred.
  local target="$1"
  local tmp
  tmp="$(mktemp)" || die "mktemp failed"

  cat >"$tmp" || { rm -f "$tmp"; die "Failed to write temp file for $target"; }

  if [[ -f "$target" ]] && cmp -s "$tmp" "$target"; then
    rm -f "$tmp"
    info "Unchanged: $target"
    return 0
  fi

  ensure_parent_dir "$target"
  see mv -f "$tmp" "$target" || { rm -f "$tmp"; die "Failed to move temp into place: $target"; }
  UNIT_CHANGED=1
  info "Updated: $target"
}

write_unit_files_idempotent() {
  local svc="/etc/systemd/system/${SERVICE_NAME}.service"

  info "Ensuring unit file (idempotent)"

  write_if_changed "$svc" <<EOF
[Unit]
Description=Configure HDMI mirroring via xrandr
Wants=display-manager.service
After=display-manager.service

[Service]
Type=oneshot
ExecStart=$INSTALL_PATH

[Install]
WantedBy=graphical.target
EOF

  [[ -f "$svc" ]] && ensure_mode "$svc" 0644
}

daemon_reload_if_needed() {
  if [[ "${UNIT_CHANGED:-0}" -eq 1 ]]; then
    info "Unit content changed; reloading systemd daemon"
    see systemctl daemon-reload || die "systemctl daemon-reload failed"
  else
    info "No unit changes detected; skipping systemd daemon-reload"
  fi
}

enable_and_maybe_test_run_service() {
  local s="${SERVICE_NAME}.service"

  if systemctl is-enabled --quiet "$s" 2>/dev/null; then
    info "Already enabled: $s"
  else
    info "Enabling: $s"
    see systemctl enable "$s" || die "Failed to enable $s"
  fi

  # Convenience: run once now only if something changed
  if [[ "${UNIT_CHANGED:-0}" -eq 1 || "${SCRIPT_CHANGED:-0}" -eq 1 ]]; then
    info "Changes detected; resetting failures and running $s once now"
    systemctl reset-failed "$s" >/dev/null 2>&1 || true
    see systemctl start "$s" || die "Failed to start $s"
  else
    info "No changes detected; not starting $s (it will run next boot)."
  fi
}

show_status() {
  info "Status: ${SERVICE_NAME}.service"
  systemctl --no-pager status "${SERVICE_NAME}.service" 2>&1 | tee -a "$INSTALLER_LOG_FILE" >&2 || true
  info "Logs: sudo journalctl -o short-iso --no-hostname -u mirror4k.service -b --no-pager"
}

remove_units() {
  local svc="/etc/systemd/system/${SERVICE_NAME}.service"

  info "Disabling/stopping (best effort): ${SERVICE_NAME}.service"
  if ! systemctl disable --now "${SERVICE_NAME}.service" >/dev/null 2>&1; then
    warn "Could not disable/stop ${SERVICE_NAME}.service (continuing)"
  fi

  info "Removing unit file (if present)"
  if ! rm -f "$svc"; then
    warn "Could not remove $svc (continuing)"
  fi

  info "Reloading systemd daemon"
  see systemctl daemon-reload || die "systemctl daemon-reload failed"

  info "Removed: ${SERVICE_NAME}.service"
}

# -------------------------- main --------------------------

init_logging
require_root

inpath_or_die cat
inpath_or_die tee
inpath_or_die cmp
inpath_or_die mktemp
inpath_or_die stat
inpath_or_die systemctl

if [[ "${1-}" == "--help" || "${1-}" == "-h" ]]; then
  usage
fi

if [[ "${1-}" == "--remove" ]]; then
  remove_units
  info "Done."
  exit 0
fi

if [[ -n "${3-}" ]]; then
  usage
fi

require_readable_file "$SRC_SCRIPT"

UNIT_CHANGED=0
SCRIPT_CHANGED=0

install_or_fixup_script "$SRC_SCRIPT" "$INSTALL_PATH"
write_unit_files_idempotent
daemon_reload_if_needed
enable_and_maybe_test_run_service
show_status

info "Done."
