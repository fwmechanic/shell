#!/usr/bin/env bash
# env-report.sh
# 1) defined non-*_KEY variables                -> NAME=VALUE
# 2) every *_KEY reference                      -> NAME=LEN or NAME
# 3) undefined / empty non-*_KEY variables      -> NAME
# a blank line separates each section

mapfile -t vars < <(
  rg -g '!node_modules/**' -o --no-filename --no-line-number \
     --replace '$1' \
     'process\.env\.([A-Za-z_][A-Za-z0-9_]*)' "${@:-.}" |
  sort -u
)

defined_nonkey=()
key_section=()
undefined_nonkey=()

for v in "${vars[@]}"; do
  val="${!v}"                      # value (may be empty)

  if [[ $v == *_KEY ]]; then       # --- *_KEY section ---
    if [[ -n $val ]]; then
      key_section+=("$v=${#val}")  # show length
    else
      key_section+=("$v")          # unset/empty key
    fi

  elif [[ -n $val ]]; then         # --- defined non-key ---
    defined_nonkey+=("$v=$val")

  else                             # --- undefined non-key ---
    undefined_nonkey+=("$v")
  fi
done

printf '%s\n' "${defined_nonkey[@]}"

((${#key_section[@]})) && {
  printf '\n'
  printf '%s\n' "${key_section[@]}"
}

((${#undefined_nonkey[@]})) && {
  printf '\n'
  printf '%s\n' "${undefined_nonkey[@]}"
}

